@page "{id:int?}"
@model Culda_Andrada_Lab2.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<!-- Tabelul cu toate categoriile -->
<table class="table">
    <thead>
        <tr>
            <th>Category Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.CategoryD.Categories)
        {
            
                var selectedRow = item.ID == Model.CategoryD.CategoryID ? "table-success" : ""; 
             
            <tr class="@selectedRow">
                <td>@item.CategoryName</td>
                <td>
                    <a asp-page="./Index" asp-route-id="@item.ID">Select</a>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Tabelul cu cărțile din categoria selectată -->
@if (Model.CategoryD.Books != null && Model.CategoryD.Books.Any())
{
    <h3>Books in Selected Category</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.CategoryD.Books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@($"{book.Author.FirstName} {book.Author.LastName}")</td>
                </tr>
            }
        </tbody>
    </table>
}
